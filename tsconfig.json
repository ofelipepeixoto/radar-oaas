{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.ts"],
  "exclude": ["dist", "node_modules", "examples", "tests/supabase"]
}
