# Copie para .env.local. Sem estas variáveis, apenas a demonstração funciona.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nunca use service_role no navegador. Nenhuma chave real acompanha este arquivo.
ASTRO_TELEMETRY_DISABLED=1
# IA real permanece desligada. Campos adicionais descritos em docs/ai.md.
AI_PROVIDER=simulated
AI_ENABLED=false
AI_DEPLOYMENT_LIMIT_CONFIGURED=false
OPENAI_MODEL=
OPENAI_API_KEY=
